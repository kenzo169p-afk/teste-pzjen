# ==============================================================================
# PJzen | Configurações de Ambiente (Supabase & E-mail)
# ==============================================================================

# --- SUPABASE STORAGE ---
# URL do seu projeto Supabase (Ex: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Chave API do Supabase (Anon Key ou Service Role Key)
SUPABASE_KEY=

# Nome do bucket criado no Supabase Storage (deve ser público ou ter permissão de leitura)
SUPABASE_BUCKET=pjzen-docs

# --- SERVIÇO DE E-MAIL (SMTP) ---
# Caso deseje envio real de e-mails, configure as credenciais SMTP abaixo.
# Se deixado em branco, o sistema simulará o envio exibindo o log detalhado no console.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=nao-responda@pjzen.com.br
SMTP_USE_TLS=True
