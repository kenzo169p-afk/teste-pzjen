# ------------------------------------------------------------------------------
# 1. Configurações de E-mail (SMTP)
# ------------------------------------------------------------------------------
# Para enviar os e-mails automaticamente usando sua conta do Gmail:
# 1. Ative a verificação em duas etapas: https://myaccount.google.com/security
# 2. Acesse: https://myaccount.google.com/apppasswords
# 3. Crie um app chamado "PJzen" e copie a senha de 16 letras gerada pelo Google.
# 4. Cole a senha de 16 letras no campo SMTP_PASSWORD abaixo:

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kenzo169p@gmail.com
SMTP_PASSWORD=
SMTP_SENDER=kenzo169p@gmail.com
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 2. Configurações do Supabase Storage (Opcional)
# ------------------------------------------------------------------------------
# Se não preenchido, os arquivos são salvos localmente na pasta /uploads/
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=handoff-anexos
